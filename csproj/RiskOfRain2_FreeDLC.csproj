<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Version>0.0.2</Version>
    <GameManagedPath Condition="'$(GameManagedPath)' == ''">$(ROR2_MANAGED_PATH)</GameManagedPath>
    <BepInExCorePath Condition="'$(BepInExCorePath)' == ''">$(BEPINEX_CORE_PATH)</BepInExCorePath>
    <ArtifactDir>$(MSBuildProjectDirectory)/../artifacts</ArtifactDir>
  </PropertyGroup>

  <Target Name="CheckLocalReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameManagedPath)/RoR2.dll')"
           Text="Set GameManagedPath to the current game's Risk of Rain 2_Data/Managed directory." />
    <Error Condition="!Exists('$(BepInExCorePath)/BepInEx.dll')"
           Text="Set BepInExCorePath to a BepInEx 5 core directory." />
  </Target>

  <ItemGroup>
    <Reference Include="RoR2" HintPath="$(GameManagedPath)/RoR2.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GameManagedPath)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManagedPath)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="com.unity.multiplayer-hlapi.Runtime" HintPath="$(GameManagedPath)/com.unity.multiplayer-hlapi.Runtime.dll" Private="false" />
    <Reference Include="UnityEngine.UNETModule" HintPath="$(GameManagedPath)/UnityEngine.UNETModule.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(BepInExCorePath)/BepInEx.dll" Private="false" />
  </ItemGroup>

  <Target Name="PackageMod" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <RemoveDir Directories="$(ArtifactDir)/package" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ArtifactDir)/package/plugins/RiskOfRain2_FreeDLC" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../README.md;$(MSBuildProjectDirectory)/../LICENSE;$(MSBuildProjectDirectory)/../RiskOfRain2_FreeDLC/manifest.json;$(MSBuildProjectDirectory)/../RiskOfRain2_FreeDLC/icon.png"
          DestinationFolder="$(ArtifactDir)/package" />
    <ZipDirectory SourceDirectory="$(ArtifactDir)/package"
                  DestinationFile="$(ArtifactDir)/RiskOfRain2_FreeDLC-$(Version).zip" Overwrite="true" />
  </Target>
</Project>
